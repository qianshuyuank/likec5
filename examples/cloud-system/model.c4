model {

  customer = actor 'Cloud System Customer' 'Interacts with the system' {
    title:zh '云平台客户'
    technology:zh '终端用户'
    description:zh '与云系统交互并使用核心功能'
    description '''
      Long description

      ## Markdown

      ```
      Code block
      ```

      - List item
      - List item
      - List item

      ## Table

      | Column 1 | Column 2 | Column 3 |
      | -------- | -------- | -------- |
      | Row 1    | Row 1    | Row 1    |
      | Row 2    | Row 2    | Row 2    |
      | Row 3    | Row 3    | Row 3    |
  '''
  }

  cloud = system 'Cloud System' {
    title:zh '云端核心系统'
    description:zh '为企业客户提供前沿技术交互的 SaaS 云平台'
    description '
      Our SaaS platfrom that allows
      customers to interact with
      the latest technologies
    '

    ui = container 'Frontends' {
      title:zh '前端应用中心'
      technology:zh 'Web 应用 / React'
      description:zh '云系统的所有用户端前端应用聚合'
      description '
        All the frontend applications
        of Cloud System
      '
      style {
        shape browser
      }
      metadata {
        version '2.1.1'
      }
    }

    legacy = container 'Cloud Legacy' {
      title:zh '旧版云服务'
      technology:zh '遗留架构'
      description:zh '面向首批客户交付的 SaaS MVP 遗留版本'
      description '
        The legacy version of our SaaS
        MVP as was presented to the first customers
      '
      link ./.github/workflows/update-diagrams.yml#L19-L25 'L19-L25'
    }

    next = container 'Cloud Next' {
      title:zh '下一代云架构'
      technology:zh '微服务集群'
      description:zh '面向未来的全新云端服务核心架构'
      description 'Cloud Next is the next version of our cloud systems'
    }

    supportUser = actor 'Support User' {
      title:zh '技术支持人员'
      description:zh '客户成功与支持团队成员，拥有受限的运维权限'
      description '
        Support team member
        Has limited access to the system
      '
      -> customer 'helps with questions' {
        title:zh '解答客户日常咨询'
        metadata {
          rps '1000'
        }
      }
    }
  }
  customer .uses cloud 'uses and pays' {
    title:zh '使用服务并付费'
    navigateTo dynamic-view-1
  }

}

views {

  view index {
    title 'Landscape'
    description '''
> [!NOTE]
> Information that users should know.

> [!TIP]
> Helpful advice for better results.

> [!IMPORTANT]
> Key information for success.

> [!WARNING]
> Urgent information to avoid problems.

> [!CAUTION]
> Risks or negative outcomes.
    '''


    group 'SAAS' {
      color primary
      opacity 20%
      include *
      exclude customer
    }
    group 'External' {
      color green
      opacity 100%
      include
        customer with {
          color green
        }
      exclude -> customer
    }

  }

  view customer of customer {
    include customer

    group {
      include
        *,
        customer -> cloud.ui with {
          color red
        },
        supportUser
    }

    style supportUser {
      color indigo
    }
    autoLayout BottomTop
  }

  dynamic view dynamic-view-1 {
    title 'Dynamic View Example'

    link https://docs.likec4.dev/dsl/views/dynamic/ 'Docs'

    customer -> ui.dashboard 'opens' {
      notes '
        Customer opens dashboard in Browser
      '
    }
    ui.dashboard -> cloud.graphql {
      title '
        requests data overt rest
        for dashboard
      '
      technology 'unknown'
      notes '
        Next notes
        Multi line
      '
    }
    cloud.graphql -> cloud.next.backend 'reads'
    parallel {
      cloud.next.backend -> amazon.lambdas.fn_enrich 'triggers'
      cloud.next.backend -> cloud.legacy.backend.services 'calls legacy'
      amazon.lambdas.fn_enrich -> cloud.next.events 'publishes'
    }
    cloud.graphql <- cloud.next.backend

    ui.dashboard <- cloud.graphql 'returns' {
      technology 'unknown'
      navigateTo cloud-to-amazon
    }

    include cloud

    autoLayout TopBottom

    style * {
      size sm
    }

    style customer {
      color green
    }
    style ui.* {
      icon none
      size sm
    }
    style cloud {
      opacity 40%
      color muted
    }
  }

  dynamic view cloud-to-amazon {
    title 'Cloud to amazon'

    next.backend -> next.events {
      notes '
      - Backend triggers EventManager
      - These calls enriched with data before publishing
      '
    }

    parallel {
      next.events -> amazon.sqs
      next.backend -> amazon.aurora
      ui.supportPanel -> amazon.aurora
    }

    include next, ui, amazon

    style next, ui, amazon {
      opacity 40%
    }

    autoLayout TopBottom
  }

}
