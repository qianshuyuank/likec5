model {

  amazon = externalSystem 'Amazon' {
    title:zh '亚马逊云服务 (AWS)'
    description:zh '全球领先的云基础设施与托管服务提供商'
    description: 'Cloud and managed services provider'
    icon tech:amazon-web-services
    style {
      color amber
    }

    rds = container 'RDS' {
      title:zh 'RDS 关系型数据库服务'
      technology:zh 'AWS RDS 托管实例'
      description:zh '云上高可用托管关系型数据库集群'
      description: 'Relational Database Service'
      icon aws:rds
      style {
        shape storage
      }

      pg = component 'PostgreSQL' {
        #db
        icon tech:postgresql

        tblUsers = table 'Users Table' {
          #deprecated
          description: '
            Table with registered users. Contains references to Identity provider.
            [deprecated, moving to Aurora]
          '
          icon https://icons.terrastruct.com/dev%2Fpostgresql.svg
        }
      }

    }

    sqs = container {
      title: 'SQS'
      title:zh 'SQS 消息队列服务'
      technology:zh 'AWS SQS'
      description:zh '高可靠、高度可扩展的分布式消息队列托管服务'
      description: 'Simple Queue Service'
      icon aws:simple-queue-service

      queue queue1 'Raw Data' {
        title:zh '原始数据队列'
        description:zh '接入待处理的原始业务消息数据'
        description: 'Queue with raw data'
      }

      queue queue2 'Enriched Data' {
        title:zh '富化数据队列'
        description:zh '经过清洗与上下文数据补全的消息流，供下游处理'
        description: '
          Filtered and preprocessed data
          Ready for further processing
        '
      }
    }

    lambdas = container {
      #db, #deprecated #api
      title: 'Lambdas'
      description: 'Serverless compute'

      fn_enrich = lambda 'Enrichment' {
        title:zh '数据富化函数'
        technology:zh 'Node.js 运行时'
        description:zh '读取原始队列数据，拼接关联上下文后投递至富化队列'
        description: '
          Enriches raw data
          by adding additional information
        '
      }

      fn_enrich -> queue1 "reads raw data" {
        title:zh "读取原始数据"
      }
      fn_enrich -> queue2 "writes enriched data" {
        title:zh "写入富化数据"
      }
    }
  }

}

views {

  view amazon of amazon {
    title "Overview Amazon"

    include
      *,
      cloud,
      cloud.* -> amazon.*,

    style * {
      color secondary
    }
    style amazon, cloud {
      color muted
    }
    style amazon.* {
      color green
    }
  }

  view amazon_sqs of sqs {
    title 'Overview Amazon SQS'

    include
      *,
      amazon
  }

  view amazon_lambdas of lambdas {
    title: 'Overview Amazon Lambdas'

    include
      *,
      amazon,
      amazon.sqs,
      -> amazon.sqs.*

    style * {
      color secondary
    }
    style amazon {
      color muted
    }
    style lambdas, lambdas.* {
      color green
    }
  }

  view amazon_rds of amazon.rds {
    title 'Overview Amazon RDS'

    include
      *,
      cloud,
      cloud.* -> amazon.rds.pg.*,
      cloud.* -> amazon.rds.aurora.*,

    style * {
      color muted
    }
    style cloud.* {
      color secondary
    }
    style amazon.rds.* {
      color green
    }
  }

}
